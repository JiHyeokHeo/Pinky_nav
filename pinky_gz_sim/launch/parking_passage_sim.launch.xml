<?xml version="1.0"?>

<!--
  Two-Pinky scenario based on the right-hand map in map_photo_vs_nav_draft.jpg.
  pinky1 is spawned at the marked parking position and receives no command.
  pinky2 is spawned in the free route and is controlled through /pinky2/cmd_vel.
-->
<launch>
  <arg name="gui" default="true"/>
  <arg name="world" default="$(find-pkg-share pinky_gz_sim)/worlds/parking_passage.world"/>

  <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share pinky_description)/../:/$(find-pkg-share pinky_gz_sim)/models:/$(env HOME)/.gazebo/models"/>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r -s -v4, $(var world)"/>
    <arg name="on_exit_shutdown" value="true"/>
  </include>
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" if="$(var gui)">
    <arg name="gz_args" value="-g -v4"/>
  </include>

  <include file="$(find-pkg-share pinky_description)/launch/upload_robot.launch.py">
    <arg name="namespace" value="pinky1"/>
    <arg name="use_sim_time" value="True"/>
    <arg name="is_sim" value="True"/>
  </include>
  <include file="$(find-pkg-share pinky_description)/launch/upload_robot.launch.py">
    <arg name="namespace" value="pinky2"/>
    <arg name="use_sim_time" value="True"/>
    <arg name="is_sim" value="True"/>
  </include>

  <!-- pinky1: parked in the upper free bay. Do not publish /pinky1/cmd_vel. -->
  <node pkg="ros_gz_sim" exec="create" name="create_pinky1" output="screen"
        args="-name pinky1 -topic /pinky1/robot_description -x -0.35 -y 0.90 -z 0.10 -Y 0.0">
    <param name="use_sim_time" value="True"/>
  </node>

  <!-- pinky2: starts in the lower free section and can pass through the map. -->
  <node pkg="ros_gz_sim" exec="create" name="create_pinky2" output="screen"
        args="-name pinky2 -topic /pinky2/robot_description -x 0.65 -y -0.45 -z 0.10 -Y 1.57">
    <param name="use_sim_time" value="True"/>
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="pinky1_bridge" output="screen"
        args="--ros-args -p config_file:=$(find-pkg-share pinky_gz_sim)/params/pinky1_bridge.yaml"/>
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="pinky2_bridge" output="screen"
        args="--ros-args -p config_file:=$(find-pkg-share pinky_gz_sim)/params/pinky2_bridge.yaml"/>
</launch>
