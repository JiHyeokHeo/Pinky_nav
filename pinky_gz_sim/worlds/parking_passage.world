<?xml version="1.0"?>
<!--
  Collision world traced from the right-hand occupancy map in
  map_photo_vs_nav_draft.jpg (pinky_navigation/map/map_v4.pgm).

  The source map is scaled 2x: 0.05 m cells become 0.10 m cells, yielding a
  usable 2.60 x 4.10 m indoor layout for two Pinky robots.
-->
<sdf version="1.8">
  <world name="parking_passage">
    <physics name="physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <light type="directional" name="sun"><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.4 0.3 -0.9</direction></light>
    <model name="floor">
      <static>true</static><link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>3.6 5.1</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>3.6 5.1</size></plane></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>
    <model name="map_walls"><static>true</static>
