<?xml version="1.0"?>
<package format="3">
  <name>pinky_multi_robot</name>
  <version>0.1.0</version>
  <description>Nav2 goal coordinator and mission action server for two Pinky robots.</description>
  <maintainer email="tory@example.com">tory</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>pinky_interfaces</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
